{
  "name": "@dopry/pecans",
  "version": "2.0.0-next.17",
  "description": "Server to make GitHub releases (private) available to download with Squirrel support",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist/"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "homepage": "https://github.com/dopry/pecans",
  "license": "Apache-2.0",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "qs": "^6.15.3",
    "semver": "^7.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.1",
    "@semantic-release/git": "^10.0.1",
    "@types/debug": "^4.1.8",
    "@types/destroy": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/semver": "^7.3.9",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "nanoid": "^3.3.6",
    "nock": "^14.0.16",
    "prettier": "^3.9.5",
    "semantic-release": "^21.1.1",
    "sinon": "^14.0.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.4"
  },
  "bugs": {
    "url": "https://github.com/dopry/pecans/issues"
  },
  "authors": [
    {
      "name": "Darrel O'Pry"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopry/pecans.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "semantic-release": "semantic-release"
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "main",
      {
        "name": "next",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGES.md"
        }
      ],
      [
        "@semantic-release/npm"
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGES.md",
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "type": "commonjs",
  "sideEffects": false
}
