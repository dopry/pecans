{
  "name": "@dopry/pecans",
  "version": "2.0.0-next.17",
  "description": "Server to make GitHub releases (private) available to download with Squirrel support",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/mjs/index.js",
  "homepage": "https://github.com/dopry/pecans",
  "license": "Apache-2.0",
  "dependencies": {
    "@octokit/rest": "^20.0.1",
    "@octokit/webhooks": "^12.0.3",
    "express": "^4.18.1",
    "express-useragent": "^1.0.15",
    "semver": "^7.3.7",
    "ts-node": "^10.8.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.1",
    "@semantic-release/git": "^10.0.1",
    "@types/debug": "^4.1.8",
    "@types/destroy": "^1.0.0",
    "@types/express": "^4.17.13",
    "@types/express-useragent": "^1.0.2",
    "@types/semver": "^7.3.9",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "nanoid": "^3.3.6",
    "nock": "^14.0.16",
    "nodemon": "^2.0.16",
    "semantic-release": "^21.1.1",
    "sinon": "^14.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "bugs": {
    "url": "https://github.com/dopry/pecans/issues"
  },
  "authors": [
    {
      "name": "Darrel O'Pry"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dopry/pecans.git"
  },
  "scripts": {
    "build": "rm -fr dist/* && tsc -p tsconfig.mjs.json && tsc -p tsconfig.cjs.json && ./fixup.sh",
    "dev": "nodemon -e ts,json --watch src --exec \"npm start\"",
    "start": "ts-node -P tsconfig.cjs.json src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "semantic-release": "semantic-release"
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "main",
      {
        "name": "next",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGES.md"
        }
      ],
      [
        "@semantic-release/npm"
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGES.md",
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
