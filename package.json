{
  "name": "@dopry/pecans",
  "version": "0.0.0-semantic-release",
  "description": "Server to make GitHub releases (private) available to download with Squirrel support",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist/"
  ],
  "main": "./dist/index.js",
  "homepage": "https://github.com/dopry/pecans",
  "license": "Apache-2.0",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "qs": "^6.15.3",
    "semver": "^7.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/semver": "^7.7.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "nanoid": "^6.0.0",
    "nock": "^14.0.16",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.0"
  },
  "bugs": {
    "url": "https://github.com/dopry/pecans/issues"
  },
  "authors": [
    {
      "name": "Darrel O'Pry"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopry/pecans.git"
  },
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "semantic-release": "semantic-release"
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "main",
      {
        "name": "next",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "sideEffects": false
}
